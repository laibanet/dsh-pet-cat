{
  "name": "dsh-pet-cat",
  "version": "0.12.5",
  "private": false,
  "description": "A transparent, frameless pet-the-cat window for DeepSeek Harness: drag the cat to move it, hold it to pick another cat (by the original author, zubu).",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "decoration",
    "cat"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laibanet/dsh-pet-cat.git"
  },
  "homepage": "https://github.com/laibanet/dsh-pet-cat#readme",
  "bugs": {
    "url": "https://github.com/laibanet/dsh-pet-cat/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "site/index.html",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
